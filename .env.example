# FinVerify AI Environment Configuration
# Copy this file to .env and fill in your API key(s)

# Preferred LLM Provider: "gemini" or "groq"
LLM_PROVIDER=gemini

# Google Gemini API Key (Get at: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (Get at: https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here

# Optional: Default model names
GEMINI_MODEL=gemini-3.8-flash
GROQ_MODEL=llama-3.3-70b-versatile
